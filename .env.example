# Medical Invoice Parser - Inference Layer Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# OpenAI Configuration (required for SLM fallback)
# =============================================================================

# Your OpenAI API key (get one at https://platform.openai.com/api-keys)
# If not set, inference runs in keyword-only mode (no SLM fallback)
INFERENCE_OPENAI_API_KEY=sk-proj-xxxxx

# Model to use for inference (default: gpt-4o-mini)
# gpt-4o-mini is recommended for cost/speed balance
INFERENCE_OPENAI_MODEL=gpt-4o-mini

# Request timeout in seconds (default: 30.0)
INFERENCE_OPENAI_TIMEOUT=30.0

# Max retries on transient failures (default: 2)
INFERENCE_OPENAI_MAX_RETRIES=2

# =============================================================================
# Inference Behavior
# =============================================================================

# Enable SLM fallback when keywords don't match (default: true)
# Set to false for keyword-only mode even with API key configured
INFERENCE_ENABLE_SLM_FALLBACK=true

# Minimum confidence to accept SLM inference result (default: 0.8)
# Lower values = more SLM results accepted, higher = more HITL flagged
INFERENCE_SLM_CONFIDENCE_THRESHOLD=0.8
